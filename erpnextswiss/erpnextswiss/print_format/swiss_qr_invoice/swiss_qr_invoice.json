 "html": "<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color:#000;\">\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\n<!-- En-tete -->\n<table style=\"width:100%;\"><tr>\n  <td style=\"vertical-align:top;\">\n    <div style=\"font-size:13pt;font-weight:bold;\">{{ company.company_name }}</div>\n    <div style=\"font-size:9pt;white-space:pre-line;\">{{ (company.get('company_address_display') or '') | striptags }}</div>\n  </td>\n  <td style=\"text-align:right;vertical-align:top;\">\n    <div style=\"font-size:15pt;font-weight:bold;\">{{ _(\"Invoice\") }}</div>\n    <div>{{ doc.name }}</div>\n    <div>{{ frappe.utils.formatdate(doc.posting_date) }}</div>\n  </td>\n</tr></table>\n\n<!-- Client -->\n<div style=\"margin-top:8mm;\">\n  <div style=\"font-weight:bold;\">{{ doc.customer_name }}</div>\n  <div style=\"font-size:9pt;\">{{ (doc.address_display or '') | safe }}</div>\n</div>\n\n<!-- Lignes -->\n<table style=\"width:100%;border-collapse:collapse;margin-top:8mm;font-size:9pt;\">\n  <thead><tr style=\"border-bottom:1px solid #000;\">\n    <th style=\"text-align:left;padding:2px 4px;\">{{ _(\"Description\") }}</th>\n    <th style=\"text-align:right;padding:2px 4px;\">{{ _(\"Qty\") }}</th>\n    <th style=\"text-align:right;padding:2px 4px;\">{{ _(\"Rate\") }}</th>\n    <th style=\"text-align:right;padding:2px 4px;\">{{ _(\"Amount\") }}</th>\n  </tr></thead>\n  <tbody>\n  {% for row in doc.items %}\n    <tr style=\"border-bottom:1px solid #eee;\">\n      <td style=\"padding:2px 4px;\">{{ row.item_name }}{% if row.description and (row.description | striptags | trim) and (row.description | striptags | trim) != row.item_name %}<br><span style=\"font-size:8pt;color:#555;\">{{ row.description | striptags }}</span>{% endif %}</td>\n      <td style=\"text-align:right;padding:2px 4px;\">{{ \"%.2f\"|format(row.qty) }} {{ row.uom }}</td>\n      <td style=\"text-align:right;padding:2px 4px;\">{{ \"%.2f\"|format(row.rate) }}</td>\n      <td style=\"text-align:right;padding:2px 4px;\">{{ \"%.2f\"|format(row.amount) }}</td>\n    </tr>\n  {% endfor %}\n  </tbody>\n</table>\n\n<!-- Totaux -->\n<table style=\"width:100%;margin-top:4mm;font-size:9pt;\"><tr><td></td><td style=\"width:60mm;\">\n  <table style=\"width:100%;\">\n    <tr><td>{{ _(\"Net Total\") }}</td><td style=\"text-align:right;\">{{ doc.currency }} {{ \"%.2f\"|format(doc.net_total) }}</td></tr>\n    {% for t in doc.taxes %}\n    <tr><td>{{ t.description | striptags }}</td><td style=\"text-align:right;\">{{ doc.currency }} {{ \"%.2f\"|format(t.tax_amount) }}</td></tr>\n    {% endfor %}\n    {% if doc.rounding_adjustment %}\n    <tr><td>{{ _(\"Rounding\") }}</td><td style=\"text-align:right;\">{{ doc.currency }} {{ \"%.2f\"|format(doc.rounding_adjustment) }}</td></tr>\n    {% endif %}\n    <tr style=\"font-weight:bold;border-top:1px solid #000;\"><td>{{ _(\"Total\") }}</td><td style=\"text-align:right;\">{{ doc.currency }} {{ \"%.2f\"|format(doc.rounded_total or doc.grand_total) }}</td></tr>\n  </table>\n</td></tr></table>\n\n<!-- Bulletin QR (rendu LOCAL via qrbill, aucune requete externe) -->\n<div style=\"margin-top:10mm;page-break-inside:avoid;\">\n  {{ get_qr_bill_svg(doc) | safe }}\n</div>\n</div>",
